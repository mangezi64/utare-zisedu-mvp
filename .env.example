# =============================================================================
# UTARE ZISEDU AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local (or .env) before starting the application:
#   cp .env.example .env.local
#
# NOTE: The MVP includes a smart Demo/Fallback mode! If you have not yet added
# live Supabase or Gemini credentials, the app will still run seamlessly in
# Docker using realistic Zimbabwe survey seed data and deterministic AI output.
# =============================================================================

# --- Application Settings ---
NEXT_PUBLIC_APP_NAME="Utare ZISEDU AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Gemini AI Configuration (AI Pathway Engine & Resume Studio) ---
# How to get your API key:
# 1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Sign in with your Google account and click "Create API Key"
# 3. Copy the key (starts with "AIzaSy...") and paste it below
#
# Architecture & Security Notice:
# All AI calls run strictly on the backend/server-side in Docker.
# Candidates in "Candidate View" never see the API key, model debuggers,
# or internal prompts. Facilitators can test latency via the Admin Console.
GEMINI_API_KEY="AIzaSyYourActualGoogleGeminiApiKeyHere"

# Choose your Gemini model:
# - gemini-2.5-flash (Default: Recommended for fast, responsive career roadmaps and diagnostics)
# - gemini-2.5-pro   (Deeper reasoning for complex CV analysis & long-form cover letters)
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Override Gemini API Endpoint or Version if using a private proxy or EU region
# GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com"

# --- Containerized PostgreSQL Database (Docker Service: db) ---
# Connection string used by Next.js inside the Docker network:
DATABASE_URL="postgresql://utare_user:utare_password@db:5432/utare_db"

# Connection string if accessing PostgreSQL directly from host terminal (outside Docker):
# DATABASE_URL_HOST="postgresql://utare_user:utare_password@localhost:5432/utare_db"

# --- Optional Supabase Configuration (Alternative Cloud Hosted Database) ---
# If using cloud-hosted Supabase instead of the local Docker PostgreSQL container:
# Get these from your Supabase Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
