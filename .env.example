# =============================================================================
# UTARE ZISEDU AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local (or .env) before starting the application:
#   cp .env.example .env.local
#
# NOTE: The MVP includes a smart Demo/Fallback mode! If you have not yet added
# live Supabase or Gemini credentials, the app will still run seamlessly in
# Docker using realistic Zimbabwe survey seed data and deterministic AI output.
# =============================================================================

# --- Application Settings ---
NEXT_PUBLIC_APP_NAME="Utare ZISEDU AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Gemini AI Configuration (Task #3: AI Career Path & Resume Engine) ---
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Supabase Configuration (Task #1, #3, #4: Auth & PostgreSQL Database) ---
# Get these from your Supabase Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
