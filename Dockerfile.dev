# =============================================================================
# UTARE ZIMEDU AI — Development Container (Node 20 LTS on Alpine)
# =============================================================================
# Ensures every team member (macOS, Windows WSL2, Linux) runs the exact same
# Node.js & npm versions with instant hot-reloading.
# =============================================================================

FROM node:20-alpine

# Install system dependencies required by some native node packages & git
RUN apk add --no-cache libc6-compat git bash curl

WORKDIR /app

# Copy package manifests first to leverage Docker layer caching
COPY package.json ./

# Install dependencies cleanly inside the Linux container
RUN npm install

# Copy the rest of the application source code
COPY . .

# Expose Next.js default port
EXPOSE 3000

# Enable polling for reliable file-watching across macOS & Windows Docker volumes
ENV WATCHPACK_POLLING=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

# Start Next.js in development mode bound to 0.0.0.0
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
